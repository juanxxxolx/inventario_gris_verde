# =============================================================================
# InduInventory · variables de entorno del frontend (Vite)
#
# Copiar a "apps/web/.env" si se necesita apuntar a otro origen del API.
# Con el valor por defecto "/api", Vite proxya las peticiones a Fastify en
# desarrollo y preview (ver apps/web/vite.config.ts). No requiere CORS.
# =============================================================================

# Prefijo usado por el cliente HTTP para todas las rutas de la API.
# Ejemplo con servidor separado: VITE_API_BASE_URL=http://127.0.0.1:3000/api
VITE_API_BASE_URL=/api
