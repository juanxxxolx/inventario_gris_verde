{
  "name": "@induinventory/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --packages external --sourcemap --clean",
    "start": "node dist/server.js",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed:admin": "tsx src/scripts/seed-admin.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@induinventory/contracts": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@node-rs/argon2": "^2.2.2",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ioredis": "^5.11.1",
    "jose": "^6.2.18",
    "nodemailer": "^10.6.1",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "ioredis-mock": "^8.13.1",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
