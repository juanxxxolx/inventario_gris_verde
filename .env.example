# =============================================================================
# InduInventory · variables de entorno
#
# Copiar este archivo a ".env" en la raíz del workspace.
# Todas las claves se validan con Zod en apps/api/src/config/env.ts.
# Si falta una obligatoria o tiene formato inválido, el proceso aborta con
# process.exit(1) y un mensaje indicando la variable y el motivo.
# No existe ningún secreto real en este archivo: todos son datos de ejemplo.
# =============================================================================

# --- Aplicación ---------------------------------------------------------------
# development | test | production. En production se exigen HTTPS, DB, Redis y SMTP reales.
NODE_ENV=development
# Puerto HTTP de Fastify. Entero entre 1 y 65535.
PORT=3000
# Interfaz de escucha. 127.0.0.1 en local; 0.0.0.0 dentro de un contenedor.
HOST=127.0.0.1
# Origen exacto del frontend admitido en el header Origin de POST/PUT/PATCH/DELETE.
# Debe coincidir con el host del servidor de Vite (apps/web/vite.config.ts).
APP_ORIGIN=http://127.0.0.1:5173
# URL pública usada para construir los enlaces /verify-email y /reset-password.
# Puede diferir de APP_ORIGIN: es solo para enlaces de correo, no para peticiones API.
APP_PUBLIC_URL=http://localhost:5173

# --- Base de datos ------------------------------------------------------------
# Si se deja VACÍA, la API usa PGlite embebida en PGLITE_DATA_DIR (sin Docker).
# Si se usa docker-compose.yml, mantener la URL siguiente (usuario, password y
# base creados por el servicio "postgres"). Obligatoria cuando NODE_ENV=production.
DATABASE_URL=postgresql://induinventory:induinventory_dev_password@127.0.0.1:5432/induinventory
# Directorio de persistencia de PGlite, usado solo cuando DATABASE_URL está vacía.
PGLITE_DATA_DIR=./.data/pglite

# --- Redis --------------------------------------------------------------------
# Rate limiting y contadores de bloqueo. Vacío => ioredis-mock en memoria.
# Con docker-compose.yml, mantener la URL siguiente. Obligatoria en producción.
REDIS_URL=redis://127.0.0.1:6379

# --- Seguridad y sesiones -----------------------------------------------------
# OBLIGATORIA en todos los entornos. Mínimo 32 caracteres. Generar con:
# openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
# Vigencia del access JWT y de su cookie httpOnly. 60-3600 segundos.
ACCESS_TOKEN_TTL_SECONDS=900
# Vigencia del refresh token opaco y de su cookie (path /api/auth). 3600-2592000.
REFRESH_TOKEN_TTL_SECONDS=604800
# Vigencia del token de verificación de correo. 300-604800 segundos.
EMAIL_TOKEN_TTL_SECONDS=86400
# Vigencia del token de restablecimiento de contraseña. 300-86400 segundos.
RESET_TOKEN_TTL_SECONDS=3600
# false en http://localhost. Debe ser true en producción (exige HTTPS y prefijos __Host-/__Secure-).
COOKIE_SECURE=false
# true solo detrás de reverse proxy: hace que Fastify use el IP real del cliente.
TRUST_PROXY=false

# --- Observabilidad -----------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent. En test se fuerza silent.
LOG_LEVEL=info

# --- Hash de contraseñas (Argon2id) -------------------------------------------
# Memoria en KiB. 8192-1048576. Valor por defecto del código: 19456.
ARGON2_MEMORY_KIB=19456
# Número de pasadas. 2-10.
ARGON2_TIME_COST=2
# Grado de paralelismo. 1-8.
ARGON2_PARALLELISM=1

# --- Correo transaccional -----------------------------------------------------
# Vacío => MemoryEmailSender (los correos quedan en memoria y son inspeccionables
# con GET /api/__test/last-email si ENABLE_TEST_ENDPOINTS=true). Obligatorio en producción.
SMTP_HOST=
# Puerto SMTP. 1-65535.
SMTP_PORT=587
# true para TLS implícito (normalmente 465); false para STARTTLS (587).
SMTP_SECURE=false
# Usuario SMTP. Debe definirse junto a SMTP_PASSWORD o no definirse ninguno.
SMTP_USER=
# Password SMTP. Debe definirse junto a SMTP_USER o no definirse ninguno.
SMTP_PASSWORD=
# Remitente de los correos de verificación, reset y aviso de cambio de contraseña.
EMAIL_FROM=InduInventory <no-reply@induinventory.local>

# --- Endpoints de prueba y migraciones ----------------------------------------
# false: no se registra GET /api/__test/last-email. Prohibido en producción.
ENABLE_TEST_ENDPOINTS=false
# true en desarrollo: aplica migraciones al arrancar. En producción usar pnpm db:migrate.
AUTO_MIGRATE=true

# --- Seed del administrador inicial -------------------------------------------
# Solo lo consume pnpm db:seed:admin. Sin estos dos valores el script termina con exit(1).
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@induinventory.local
# Debe ser una contraseña aleatoria de al menos 10 caracteres con mayúscula,
# minúscula, número y carácter especial. Nunca dejarla vacía en un entorno real.
SEED_ADMIN_PASSWORD=
