{
  "name": "induinventory",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @induinventory/api test:integration",
    "test:e2e": "pnpm --filter @induinventory/web test:e2e",
    "db:migrate": "pnpm --filter @induinventory/api db:migrate",
    "db:seed:admin": "pnpm --filter @induinventory/api db:seed:admin",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@node-rs/argon2",
      "@tailwindcss/oxide"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
